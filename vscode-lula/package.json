{
  "name": "lula",
  "displayName": "Lula - C++ in South African languages",
  "description": "Write C++ for robots, embedded systems and PCs in all 10 written official South African languages: isiZulu, isiXhosa, siSwati, isiNdebele, Sesotho, Setswana, Sepedi, Xitsonga, Tshivenda, Afrikaans. Syntax highlighting, error checking, hover translations and one-click run. Includes a South African Sign Language (SASL) sign-video dictionary.",
  "version": "0.4.0",
  "publisher": "lula-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Education"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:lula",
    "onLanguage:cpp",
    "onCommand:lula.convertFromCpp"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lula",
        "aliases": [
          "Lula",
          "lula"
        ],
        "extensions": [
          ".lula"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lula",
        "scopeName": "source.lula",
        "path": "./syntaxes/lula.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "lula.run",
        "title": "Lula: Qalisa / Run",
        "icon": "$(play)"
      },
      {
        "command": "lula.showCpp",
        "title": "Lula: Bonisa i-C++ / Show C++",
        "icon": "$(code)"
      },
      {
        "command": "lula.exportArduino",
        "title": "Lula: Export for Arduino (.ino)"
      },
      {
        "command": "lula.convertFromCpp",
        "title": "Lula: Convert C++ to Lula (isiZulu, Afrikaans, ...)"
      },
      {
        "command": "lula.sasl.show",
        "title": "Lula: Show SASL sign for word under cursor",
        "icon": "$(eye)"
      },
      {
        "command": "lula.sasl.browse",
        "title": "Lula: Browse SASL sign dictionary"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lula.run",
          "when": "resourceExtname == .lula",
          "group": "navigation"
        },
        {
          "command": "lula.showCpp",
          "when": "resourceExtname == .lula",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "lula.convertFromCpp",
          "when": "resourceLangId == cpp || resourceLangId == c || resourceLangId == lula",
          "group": "lula"
        },
        {
          "command": "lula.sasl.show",
          "when": "resourceLangId == lula",
          "group": "lula"
        }
      ]
    },
    "configuration": {
      "title": "Lula",
      "properties": {
        "lula.compilerPath": {
          "type": "string",
          "default": "g++",
          "description": "C++ compiler. For embedded targets use e.g. avr-g++ or arm-none-eabi-g++."
        },
        "lula.compilerArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra compiler flags (e.g. -mmcu=atmega328p)."
        },
        "lula.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Check for errors when the file is saved."
        },
        "lula.defaultLanguage": {
          "type": "string",
          "default": "zu",
          "description": "Language used when the file name has no language code (robot.lula instead of robot.zu.lula)."
        },
        "lula.sasl.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Offer South African Sign Language (SASL) sign videos when hovering keywords."
        },
        "lula.sasl.showMissing": {
          "type": "boolean",
          "default": false,
          "description": "Also mention in the hover when no SASL sign has been recorded for a word yet."
        },
        "lula.sasl.dictionaryPath": {
          "type": "string",
          "default": "",
          "description": "Folder with your own SASL dictionary (signs.json + videos/). Empty uses the one built into the extension."
        }
      }
    },
    "keybindings": [
      {
        "command": "lula.sasl.show",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus && editorLangId == lula"
      }
    ]
  }
}