{
  "name": "soga-lang",
  "displayName": "Soga",
  "description": "Write C++ and Arduino code in all 10 written official South African languages: every Arduino-compatible board (Uno, Nano, Mega, Uno R4, Nano 33, ESP32, Raspberry Pi Pico, STM32, ...), ROS 2, OpenCV, Eigen, CUDA and PyTorch, with error messages in your language and a full language server. Includes a South African Sign Language (SASL) sign-video dictionary.",
  "version": "0.7.3",
  "publisher": "mzwandilezulu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Linters",
    "Snippets"
  ],
  "main": "./lib/extension.js",
  "activationEvents": [
    "onLanguage:soga",
    "onLanguage:cpp",
    "onCommand:soga.convertFromCpp"
  ],
  "contributes": {
    "languages": [
      {
        "id": "soga",
        "aliases": [
          "Soga",
          "soga"
        ],
        "extensions": [
          ".soga"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon-light.png",
          "dark": "./images/file-icon-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "soga",
        "scopeName": "source.soga",
        "path": "./syntaxes/soga.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "soga.run",
        "title": "Soga: Qalisa / Run",
        "icon": "$(play)"
      },
      {
        "command": "soga.showCpp",
        "title": "Soga: Bonisa i-C++ / Show C++",
        "icon": "$(code)"
      },
      {
        "command": "soga.exportArduino",
        "title": "Soga: Export for Arduino (.ino)"
      },
      {
        "command": "soga.convertFromCpp",
        "title": "Soga: Convert C++ to Soga (isiZulu, Afrikaans, ...)"
      },
      {
        "command": "soga.sasl.show",
        "title": "Soga: Show SASL sign for word under cursor",
        "icon": "$(eye)"
      },
      {
        "command": "soga.sasl.browse",
        "title": "Soga: Browse SASL sign dictionary"
      },
      {
        "command": "soga.arduino",
        "title": "Soga: Build / upload to Arduino-compatible board",
        "icon": "$(circuit-board)"
      },
      {
        "command": "soga.chooseBoard",
        "title": "Soga: Choose Arduino board (Uno, ESP32, Pico, STM32, ...)",
        "icon": "$(circuit-board)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "soga.run",
          "when": "resourceExtname == .soga",
          "group": "navigation"
        },
        {
          "command": "soga.showCpp",
          "when": "resourceExtname == .soga",
          "group": "navigation"
        },
        {
          "command": "soga.arduino",
          "when": "resourceExtname == .soga",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "soga.convertFromCpp",
          "when": "resourceLangId == cpp || resourceLangId == c || resourceLangId == soga",
          "group": "soga"
        },
        {
          "command": "soga.sasl.show",
          "when": "resourceLangId == soga",
          "group": "soga"
        }
      ]
    },
    "configuration": {
      "title": "Soga",
      "properties": {
        "soga.compilerPath": {
          "type": "string",
          "default": "g++",
          "description": "C++ compiler. For embedded targets use e.g. avr-g++ or arm-none-eabi-g++."
        },
        "soga.compilerArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra compiler flags (e.g. -mmcu=atmega328p)."
        },
        "soga.defaultLanguage": {
          "type": "string",
          "default": "zu",
          "description": "Language used when the file name has no language code (robot.soga instead of robot.zu.soga)."
        },
        "soga.sasl.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Offer South African Sign Language (SASL) sign videos when hovering keywords."
        },
        "soga.sasl.showMissing": {
          "type": "boolean",
          "default": false,
          "description": "Also mention in the hover when no SASL sign has been recorded for a word yet."
        },
        "soga.sasl.dictionaryPath": {
          "type": "string",
          "default": "",
          "description": "Folder with your own SASL dictionary (signs.json + videos/). Empty uses the one built into the extension."
        },
        "soga.arduinoBoard": {
          "type": "string",
          "default": "uno",
          "markdownDescription": "Board for Arduino programs: `uno`, `nano`, `mega`, `leonardo`, `uno-r4-minima`, `uno-r4-wifi`, `nano-33-iot`, `nano-33-ble`, `pico`, `pico-w`, `pico-2`, `esp32`, `esp32-s3`, `esp32-c3`, `esp8266`, `stm32-bluepill`, `stm32-blackpill`, `nucleo-f401re`, or any full board name (FQBN) such as `arduino:samd:mkr1000`. Used for building, uploading and for checking errors as you type."
        },
        "soga.arduinoPort": {
          "type": "string",
          "default": "",
          "description": "Default serial port for uploading to an Arduino (e.g. /dev/ttyUSB0 or COM3)."
        },
        "soga.diagnostics.onType": {
          "type": "boolean",
          "default": true,
          "description": "Check for errors while you type (not only when you save)."
        },
        "soga.diagnostics.delay": {
          "type": "number",
          "default": 600,
          "minimum": 100,
          "description": "How long to wait after you stop typing before checking (milliseconds)."
        },
        "soga.messageLanguage": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zu",
            "xh",
            "ss",
            "nr",
            "st",
            "tn",
            "nso",
            "ts",
            "ve",
            "af"
          ],
          "description": "Language of error messages. 'auto' uses the file's language."
        },
        "soga.inlayHints.cppNames": {
          "type": "boolean",
          "default": false,
          "description": "Show the C++ meaning next to each Soga word (useful when learning)."
        }
      }
    },
    "keybindings": [
      {
        "command": "soga.sasl.show",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus && editorLangId == soga"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "soga",
        "scopes": {
          "property": [
            "variable.other.property.soga"
          ],
          "macro": [
            "entity.name.function.preprocessor.soga"
          ]
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "soga",
        "properties": {}
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mzwesh-1/lula.git"
  },
  "bugs": {
    "url": "https://github.com/mzwesh-1/lula/issues"
  },
  "homepage": "https://github.com/mzwesh-1/lula#readme",
  "keywords": [
    "isiZulu",
    "isiXhosa",
    "Afrikaans",
    "Sesotho",
    "Setswana",
    "Sepedi",
    "siSwati",
    "isiNdebele",
    "Xitsonga",
    "Tshivenda",
    "South Africa",
    "African languages",
    "C++",
    "Arduino",
    "ESP32",
    "Raspberry Pi Pico",
    "STM32",
    "robotics",
    "ROS 2",
    "OpenCV",
    "education",
    "language server"
  ]
}