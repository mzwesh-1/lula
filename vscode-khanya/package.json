{
  "name": "khanya",
  "displayName": "Khanya - C++ in South African languages",
  "description": "Write C++ for robots, embedded systems and PCs in all 10 written official South African languages: isiZulu, isiXhosa, siSwati, isiNdebele, Sesotho, Setswana, Sepedi, Xitsonga, Tshivenda, Afrikaans. Syntax highlighting, error checking, hover translations and one-click run. Includes a South African Sign Language (SASL) sign-video dictionary.",
  "version": "0.4.0",
  "publisher": "khanya-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Education"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:khanya",
    "onLanguage:cpp",
    "onCommand:khanya.convertFromCpp"
  ],
  "contributes": {
    "languages": [
      {
        "id": "khanya",
        "aliases": [
          "Khanya",
          "khanya"
        ],
        "extensions": [
          ".kh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "khanya",
        "scopeName": "source.khanya",
        "path": "./syntaxes/khanya.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "khanya.run",
        "title": "Khanya: Qalisa / Run",
        "icon": "$(play)"
      },
      {
        "command": "khanya.showCpp",
        "title": "Khanya: Bonisa i-C++ / Show C++",
        "icon": "$(code)"
      },
      {
        "command": "khanya.exportArduino",
        "title": "Khanya: Export for Arduino (.ino)"
      },
      {
        "command": "khanya.convertFromCpp",
        "title": "Khanya: Convert C++ to Khanya (isiZulu, Afrikaans, ...)"
      },
      {
        "command": "khanya.sasl.show",
        "title": "Khanya: Show SASL sign for word under cursor",
        "icon": "$(eye)"
      },
      {
        "command": "khanya.sasl.browse",
        "title": "Khanya: Browse SASL sign dictionary"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "khanya.run",
          "when": "resourceExtname == .kh",
          "group": "navigation"
        },
        {
          "command": "khanya.showCpp",
          "when": "resourceExtname == .kh",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "khanya.convertFromCpp",
          "when": "resourceLangId == cpp || resourceLangId == c || resourceLangId == khanya",
          "group": "khanya"
        },
        {
          "command": "khanya.sasl.show",
          "when": "resourceLangId == khanya",
          "group": "khanya"
        }
      ]
    },
    "configuration": {
      "title": "Khanya",
      "properties": {
        "khanya.compilerPath": {
          "type": "string",
          "default": "g++",
          "description": "C++ compiler. For embedded targets use e.g. avr-g++ or arm-none-eabi-g++."
        },
        "khanya.compilerArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra compiler flags (e.g. -mmcu=atmega328p)."
        },
        "khanya.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Check for errors when the file is saved."
        },
        "khanya.defaultLanguage": {
          "type": "string",
          "default": "zu",
          "description": "Language used when the file name has no language code (robot.kh instead of robot.zu.kh)."
        },
        "khanya.sasl.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Offer South African Sign Language (SASL) sign videos when hovering keywords."
        },
        "khanya.sasl.showMissing": {
          "type": "boolean",
          "default": false,
          "description": "Also mention in the hover when no SASL sign has been recorded for a word yet."
        },
        "khanya.sasl.dictionaryPath": {
          "type": "string",
          "default": "",
          "description": "Folder with your own SASL dictionary (signs.json + videos/). Empty uses the one built into the extension."
        }
      }
    },
    "keybindings": [
      {
        "command": "khanya.sasl.show",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus && editorLangId == khanya"
      }
    ]
  }
}