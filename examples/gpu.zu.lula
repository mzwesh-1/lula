// Hlanganisa ama-vector amabili ku-GPU nge-CUDA. (Add two vectors on the GPU with CUDA.)
//   lula build examples/gpu.zu.lula --cxx nvcc -- -x cu
#faka <igpu>
#faka <okokufaka_nokukhipha>
#faka <iqoqo>

umsebenzi_wegpu ize hlanganisa_amavektha(engaguquki idesimali* a, engaguquki idesimali* b, idesimali* c, inombolo n) {
    inombolo i = inombolo_yebhulokhi.x * ubukhulu_bebhulokhi.x + inombolo_yomucu.x;
    uma (i < n) c[i] = a[i] + b[i];
}

inombolo okuyinhloko() {
    ngaphambili inombolo N = 1 << 20;
    iqoqo<idesimali> a(N, 1.0f), b(N, 2.0f), c(N);
    idesimali *da, *db, *dc;
    gpu_beka_inkumbulo(&da, N * usayizi(idesimali));
    gpu_beka_inkumbulo(&db, N * usayizi(idesimali));
    gpu_beka_inkumbulo(&dc, N * usayizi(idesimali));
    gpu_kopisha_inkumbulo(da, a.idatha(), N * usayizi(idesimali), KUSUKA_KHOMPYUTHA_KUYA_GPU);
    gpu_kopisha_inkumbulo(db, b.idatha(), N * usayizi(idesimali), KUSUKA_KHOMPYUTHA_KUYA_GPU);

    ubukhulu3 imicu_ebhulokhini(256);
    ubukhulu3 amabhulokhi((N + 255) / 256);
    hlanganisa_amavektha<<<amabhulokhi, imicu_ebhulokhini>>>(da, db, dc, N);
    gpu_linda_iqede();

    Iphutha_legpu iphutha = gpu_iphutha_lokugcina();
    uma (iphutha != GPU_KUPHUMELELE) {
        bhala_iphutha << "Iphutha le-GPU: " << gpu_umbhalo_wephutha(iphutha) << umugqa;
        buyisa 1;
    }
    gpu_kopisha_inkumbulo(c.idatha(), dc, N * usayizi(idesimali), KUSUKA_GPU_KUYA_KHOMPYUTHA);
    bhala << "c[0] = " << c[0] << ", c[N-1] = " << c[N - 1] << umugqa;
    gpu_khulula_inkumbulo(da); gpu_khulula_inkumbulo(db); gpu_khulula_inkumbulo(dc);
    buyisa 0;
}
